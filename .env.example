# Copier ce fichier en .env (jamais versionné). Aucun secret ici : les jetons Instagram/GitHub vivent
# uniquement dans les « secrets » du dépôt GitHub de diffusion.

# --- Garde-fous (mode gratuit) ---
FREE_MODE=true
MAX_API_SPEND=0
X_ENABLED=false
PAID_VIDEO_GENERATION=false
PAID_TTS=false
# true seulement après la publication de contrôle (docs/DIFFUSION_CLOUD.md)
LIVE_PUBLISH=false
PAUSED=false

# --- Calendrier ---
TIMEZONE=Europe/Paris
PUBLISH_SLOTS=12:30,19:00
RESERVE_TARGET_DAYS=10

# --- Production ---
VOICE_MODEL=fr_FR-siwis-medium
VOICE_LENGTH_SCALE=0.92
RENDER_PROFILE=final
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.3\blender.exe
OLLAMA_MODEL=qwen3:14b
OLLAMA_URL=http://127.0.0.1:11434
MIN_FREE_DISK_GB=15

# --- Diffusion cloud (PC éteint) ---
# Dossier du clone local du dépôt GitHub de diffusion (créé par lbf.setup_cloud)
# CLOUD_REPO_DIR=C:\Users\<toi>\lbf-diffusion

# --- Tableau de bord ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Obligatoire seulement si tu ouvres le tableau de bord à ton téléphone (via Tailscale) :
# DASHBOARD_TOKEN=une-longue-phrase-aleatoire

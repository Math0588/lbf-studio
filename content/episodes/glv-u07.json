 "narration_segments": [
  {
   "id": "n0",
   "text": "20 h, plateau télé : Glucksmann est en train de fondre.",
   "role": "accroche",
   "claim_type": "fiction_satirique",
   "accent_words": [
    "en train de fondre"
   ]
  },
  {
   "id": "n1",
   "text": "Normal : tête de glucide. Mou, sucré, il fond sous la pression.",
   "lien": "car",
   "claim_type": "fiction_satirique",
   "accent_words": [
    "tête de glucide"
   ]
  },
  {
   "id": "n2",
   "text": "Lui-même l'assume : « Moi, les hésitations, je les aime. »",
   "lien": "donc",
   "claim_type": "citation_exacte",
   "accent_words": [
    "les hésitations"
   ]
  },
  {
   "id": "n3",
   "text": "Pour tenir, il boit un matcha à seize euros. Brûlant : il rapetisse.",
   "lien": "mais",
   "claim_type": "fiction_satirique",
   "accent_words": [
    "seize euros",
    "il rapetisse"
   ]
  },
  {
   "id": "n4",
   "text": "En face, les Insoumis haussent le ton. Il fond de moitié.",
   "lien": "mais",
   "claim_type": "fiction_satirique",
   "accent_words": [
    "de moitié"
   ]
  },
  {
   "id": "n5",
   "text": "Ses électeurs le refroidissent au lait d'avoine. Trop tard : il tient dans une tasse.",
   "lien": "donc",
   "claim_type": "fiction_satirique",
   "accent_words": [
    "lait d'avoine",
    "une tasse"
   ]
  },
  {
   "id": "n6",
   "text": "Question finale : gauche ou centre ? Le sucre flotte… pile au milieu.",
   "lien": "mais",
   "claim_type": "fiction_satirique",
   "accent_words": [
    "pile au milieu"
   ]
  },
  {
   "id": "n7",
   "text": "Envoie ça au pote qui fond dès qu'on le contredit.",
   "claim_type": "fiction_satirique",
   "accent_words": [
    "fond"
   ]
  }
 ],

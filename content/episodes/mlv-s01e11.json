 "narration_segments": [
  {
   "id": "n1",
   "text": "Dans cette ville, tout le monde vote Mélenchon. Même le chien paie l'impôt.",
   "accent_words": [
    "paie l'impôt"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n2",
   "text": "Au Bourget, sa salle scande « Taxer les riches ».",
   "accent_words": [
    "les riches"
   ],
   "claim_type": "citation_exacte"
  },
  {
   "id": "n3",
   "text": "La ville applique : les riches partent en courant, leurs yachts sur le dos.",
   "accent_words": [
    "le dos"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n4",
   "text": "Plus personne à taxer. Les habitants se taxent entre eux.",
   "accent_words": [
    "entre eux"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n5",
   "text": "Baston générale sur la place : qui taxe qui ?",
   "accent_words": [
    "qui taxe qui"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n6",
   "text": "À la fin, il ne reste qu'un contribuable : la tortue. Il la taxe.",
   "accent_words": [
    "Il la taxe"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n7",
   "text": "Envoie ça au pote qui veut taxer les riches mais pas son forfait.",
   "accent_words": [
    "son forfait"
   ],
   "claim_type": "fiction_satirique"
  }
 ],

 "narration_segments": [
  {
   "id": "n1",
   "text": "Dans cette ville, tout le monde vote Mélenchon. Prévoyez un sandwich.",
   "accent_words": [
    "Prévoyez un sandwich"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n2",
   "text": "À Lyon, il parle une heure quarante-deux, agrippé au pupitre.",
   "accent_words": [
    "au pupitre"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n3",
   "text": "La mairie impose ce discours avant chaque événement de la ville.",
   "accent_words": [
    "la ville"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n4",
   "text": "Un anniversaire ? Les bougies fondent avant la fin de l'introduction.",
   "accent_words": [
    "de l'introduction"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n5",
   "text": "Un mariage ? Les invités partent avant le oui.",
   "accent_words": [
    "le oui"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n6",
   "text": "À la fin, il reste lui et le pupitre. Le pupitre applaudit, par politesse.",
   "accent_words": [
    "par politesse"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n7",
   "text": "Envoie ça au pote qui fait un vocal de dix minutes pour dire oui.",
   "accent_words": [
    "dire oui"
   ],
   "claim_type": "fiction_satirique"
  }

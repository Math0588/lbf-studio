 "narration_segments": [
  {
   "id": "n1",
   "text": "Dans cette ville, tout le monde vote Glucksmann. En théorie.",
   "accent_words": [
    "En théorie"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n2",
   "text": "Son annonce de candidature ? Des internautes l'ont trouvée récitée, scolaire.",
   "accent_words": [
    "récitée",
    "scolaire"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n3",
   "text": "Son credo : rassembler, gouverner, gagner. Pour l'instant : une primaire.",
   "accent_words": [
    "une primaire"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n4",
   "text": "Un chroniqueur l'a comparé à Macron, en version cool. À gauche, c'est une insulte.",
   "accent_words": [
    "une insulte"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n5",
   "text": "Un universitaire parle de timidité sociale. Ici, même le mégaphone chuchote.",
   "accent_words": [
    "chuchote"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n6",
   "text": "Sa liste de 2024 s'appelait Réveiller l'Europe. La gauche, elle, fait la sieste.",
   "accent_words": [
    "la sieste"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n7",
   "text": "Envoie ça au pote qui trouve que Glucksmann, c'est Macron de gauche.",
   "accent_words": [
    "Macron de gauche"
   ],
   "claim_type": "fiction_satirique"
  }
 ],

   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n4",
   "text": "Son slogan de 2021 : « Impossible n'est pas français ». Les sondages, eux, sont français.",
   "accent_words": [
    "sont français"
   ],
   "claim_type": "citation_exacte"
  },
  {
   "id": "n5",
   "text": "Il admire Napoléon. Il en a surtout gardé Waterloo.",
   "accent_words": [
    "Waterloo"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n6",
   "text": "En 2022, sept pour cent. En 2026, quatre. Le c'était mieux avant marche enfin.",
   "accent_words": [
    "marche enfin"
   ],
   "claim_type": "fait_public"
  },
  {

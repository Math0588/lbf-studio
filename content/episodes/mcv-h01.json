 "narration_segments": [
  {
   "id": "n0",
   "text": "Dans cette ville, tout le monde vote Macron.",
   "claim_type": "fiction_satirique",
   "accent_words": []
  },
  {
   "id": "n1",
   "text": "Ici, tout se fait en même temps.",
   "claim_type": "fiction_satirique",
   "accent_words": []
  },
  {
   "id": "n2",
   "text": "Le boulanger vend la baguette cuite et pas cuite. En même temps.",
   "claim_type": "fiction_satirique",
   "accent_words": []
  },
  {
   "id": "n3",
   "text": "Au carrefour, le feu est vert et rouge. En même temps.",
   "claim_type": "fiction_satirique",
   "accent_words": []
  },
  {
   "id": "n4",
   "text": "Résultat : personne ne sait jamais s'il faut avancer.",
   "claim_type": "fiction_satirique",
   "accent_words": []
  },
  {
   "id": "n5",
   "text": "Alors le maire lance un grand débat.",
   "claim_type": "fiction_satirique",
   "accent_words": []
  },
  {
   "id": "n6",
   "text": "Il connaît : en janvier 2019, il avait déjà débattu près de sept heures avec 600 maires.",
   "claim_type": "fait_public",
   "accent_words": []
  },
  {
   "id": "n7",
   "text": "Toute la nuit. À la fin, il tranche : « on fera les deux ».",
   "claim_type": "fiction_satirique",
   "accent_words": []
  },
  {
   "id": "n8",
   "text": "Depuis, toute la ville avance. Et recule. En même temps.",
   "claim_type": "fiction_satirique",
   "accent_words": []
  },
  {
   "id": "n9",
   "text": "Bilan après un an : la ville n'a pas bougé d'un mètre.",
   "claim_type": "fiction_satirique",
   "accent_words": []
  },
  {
   "id": "n10",
   "text": "Mais attention : elle est toujours en marche.",
   "claim_type": "fiction_satirique",
   "accent_words": []
  },
  {
   "id": "n11",
   "text": "Partie 2 : la ville d'à côté a pris une décision. Une seule.",
   "claim_type": "fiction_satirique",
   "accent_words": []
  }
 ],

   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n5",
   "text": "Le conducteur, mocassins à glands, trouve ça très raisonnable.",
   "accent_words": [
    "mocassins à glands"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n6",
   "text": "Tu insistes, il recalcule : pas la route, le siècle.",
   "accent_words": [
    "le siècle"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n7",
   "text": "Porte de la ville franchie, tout redevient médiéval.",

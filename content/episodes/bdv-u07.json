   "id": "n0",
   "text": "Mariage à Châlons : personne ne regarde les mariés. Bardella est là.",
   "claim_type": "fiction_satirique",
   "accent_words": [],
   "role": "accroche"
  },
  {
   "id": "n1",
   "text": "À Châlons, l'AFP décrivait une nuée de téléphones levés pour un selfie avec lui.",
   "claim_type": "fait_public",
   "accent_words": [],
   "lien": "car"
  },
  {
   "id": "n2",
   "text": "Les invités tournent le dos aux mariés, téléphone en l'air.",
   "claim_type": "fiction_satirique",
   "accent_words": [],
   "lien": "donc"
  },
  {
   "id": "n3",
   "text": "La mariée tente son discours. Bardella se glisse dans le cadre.",
   "claim_type": "fiction_satirique",
   "accent_words": [],
   "lien": "mais"
  },
  {
   "id": "n4",
   "text": "Le photographe ne filme plus que lui.",
   "claim_type": "fiction_satirique",
   "accent_words": [],
   "lien": "donc"
  },
  {
   "id": "n5",
   "text": "Au moment du « oui », le maire lui demande son programme.",
   "claim_type": "fiction_satirique",
   "accent_words": [],
   "lien": "mais"
  },
  {
   "id": "n6",

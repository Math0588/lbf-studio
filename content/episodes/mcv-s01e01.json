 "narration_segments": [
  {
   "id": "n1",
   "text": "Dans cette ville, tout le monde vote Macron. Enfin, votait.",
   "accent_words": [
    "votait"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n2",
   "text": "Pas de boulot ? Traverse la rue. Ça marche depuis 2018, paraît-il.",
   "accent_words": [
    "paraît-il"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n3",
   "text": "Les aides ? « Un pognon de dingue ». Les dividendes ? Raisonnables.",
   "accent_words": [
    "Raisonnables"
   ],
   "claim_type": "citation_exacte"
  },
  {
   "id": "n4",
   "text": "Ça ruisselle depuis 2017. Seul truc qui coule : la dette.",
   "accent_words": [
    "la dette"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n5",
   "text": "Le maire, c'est Jupiter : il descend juste crier « Hey ! Hey ! ».",
   "accent_words": [
    "Jupiter"
   ],
   "claim_type": "citation_exacte"
  },
  {
   "id": "n7",
   "text": "Son bilan sur X : « parfois des erreurs ». Parfois. For sure.",
   "accent_words": [
    "For sure"
   ],
   "claim_type": "citation_exacte"
  },
  {
   "id": "n8",
   "text": "Envoie ça au pote qui croit encore au ruissellement.",

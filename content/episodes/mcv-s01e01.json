 "title_cover": "Le feu en même temps",
 "hook_variants": [
  "Dans cette ville, tout le monde vote Macron… et le feu ne choisit jamais.",
  "À Macronville, le feu est vert. Mais en même temps, il est rouge.",
  "Ce carrefour est bloqué depuis trois semaines. Officiellement, tout roule.",
  "Dans cette ville, même le feu rouge refuse de choisir.",
  "Ici, personne ne grille le feu. Personne ne passe non plus."
 ],
 "selected_hook": 0,
 "ending_variants": [
  "Pour lui, le feu a choisi.",
  "Puis une voiture passe enfin : le cortège du maire. Pour lui, le feu a choisi.",
  "Bilan officiel : zéro accident. Zéro voiture qui avance non plus, mais en même temps."
 ],
 "selected_ending": 0,
 "narration_segments": [
  {
   "id": "n1",
   "text": "Dans cette ville, tout le monde vote Macron… et le feu ne choisit jamais.",
   "accent_words": [
    "jamais"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n2",
   "text": "Il est vert, et en même temps, il est rouge.",
   "accent_words": [
    "rouge"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n3",
   "text": "Personne ne grille, personne ne passe : carrefour apaisé.",
   "accent_words": [
    "apaisé"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n4",
   "text": "Seules passent les trottinettes en gilet sans manches.",
   "accent_words": [
    "manches"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n5",
   "text": "Au moindre klaxon, un écran réexplique, plus lentement.",
   "accent_words": [
    "lentement"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n6",
   "text": "Pour les réfractaires, on ajoute un orange, pour l'écoute.",
   "accent_words": [
    "écoute"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n7",
   "text": "Puis une voiture passe enfin : le cortège de Jupiter.",
   "accent_words": [
    "Jupiter"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n8",
   "text": "Pour lui, le feu a choisi.",
   "accent_words": [
    "choisi"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n9",
   "text": "Le pire feu de ta ville, il est où ?",
   "accent_words": [
    "où"
   ],
   "claim_type": "fiction_satirique"
  }
 ],

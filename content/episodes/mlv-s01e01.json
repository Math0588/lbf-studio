  {
   "id": "n1",
   "text": "Dans cette ville, tout le monde vote Mélenchon. Pour la quatrième fois.",
   "accent_words": [
    "quatrième fois"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n2",
   "text": "Le maire est partout : en 2017, il tenait déjà meeting en hologramme.",
   "accent_words": [
    "hologramme"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n3",
   "text": "Un discours ici ? Une heure quarante-deux. Le café a gelé.",
   "accent_words": [
    "gelé"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n4",
   "text": "Sa devise : « le bruit et la fureur ». Les voisins voudraient dormir.",
   "accent_words": [
    "dormir"
   ],
   "claim_type": "citation_exacte"
  },
  {
   "id": "n5",
   "text": "Son totem, c'est la tortue. Quatrième course, toujours pas l'arrivée.",
   "accent_words": [
    "pas l'arrivée"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n6",
   "text": "Au Bourget, le programme était vendu sur place. La révolution, ça se paie.",
   "accent_words": [
    "ça se paie"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n7",
   "text": "Envoie ça au pote qui y croit pour la quatrième fois.",

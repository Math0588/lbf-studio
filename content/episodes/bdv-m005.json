 "narration_segments": [
  {
   "id": "n1",
   "text": "Dans cette ville, tout le monde vote Bardella. Même la brosse à dents.",
   "accent_words": [
    "brosse à dents"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n2",
   "text": "À Châlons, l'AFP décrit une nuée de téléphones levés pour un selfie avec lui.",
   "accent_words": [
    "selfie"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n3",
   "text": "Alors la mairie rend le selfie obligatoire au réveil.",
   "accent_words": [
    "obligatoire"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n4",
   "text": "Puis au déjeuner, au dîner, et sous la douche.",
   "accent_words": [
    "douche"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n5",
   "text": "Les téléphones saturent. Plus de place pour une seule photo.",
   "accent_words": [
    "photo"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n6",
   "text": "Bardella efface les photos de son programme. Ça libère zéro octet.",
   "accent_words": [
    "zéro octet"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n7",
   "text": "Envoie ça au pote qui a plus de selfies avec lui que d'idées sur lui.",
   "accent_words": [
    "idées"
   ],
   "claim_type": "fiction_satirique"
  }

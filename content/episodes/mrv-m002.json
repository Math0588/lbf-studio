 "narration_segments": [
  {
   "id": "n1",
   "text": "Dans cette ville, tout le monde vote Marine. Sur la ligne blanche.",
   "accent_words": [
    "blanche"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n2",
   "text": "Sa formule : « ni l'aile droite ni l'aile gauche ».",
   "accent_words": [
    "gauche"
   ],
   "claim_type": "citation_exacte"
  },
  {
   "id": "n3",
   "text": "Alors l'auto-école supprime les virages à droite et à gauche.",
   "accent_words": [
    "gauche"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n4",
   "text": "Les élèves passent le permis en ligne droite.",
   "accent_words": [
    "droite"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n5",
   "text": "Ils arrivent tous à la mer. Le moniteur nage.",
   "accent_words": [
    "nage"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n6",
   "text": "Marine leur remet le permis : ni droite ni gauche, tout droit dans l'eau.",
   "accent_words": [
    "eau"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n7",
   "text": "Envoie ça au pote qui met le clignotant à gauche et tourne à droite.",
   "accent_words": [
    "droite"
   ],
   "claim_type": "fiction_satirique"
  }
 ],

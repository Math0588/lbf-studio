  {
   "id": "n1",
   "text": "Dans cette ville, tout le monde vote Glucksmann. Presque.",
   "accent_words": [
    "Presque"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n2",
   "text": "Le GPS promet un cap clair. Deux ans qu'il recalcule.",
   "accent_words": [
    "recalcule"
   ],
   "claim_type": "fiction_satirique"
  },
  {
   "id": "n3",
   "text": "Notre gauche, sept fois en un discours. Le programme ? En chargement.",
   "accent_words": [
    "En chargement"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n4",
   "text": "Une rivale l'a traité de stagiaire. Ici, stage renouvelé.",
   "accent_words": [
    "stagiaire"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n5",
   "text": "Son hymne ? Glucksmann Love, chanté pour se foutre de lui.",
   "accent_words": [
    "se foutre de lui"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n6",
   "text": "Son QG en direct ? Un placard. Seul endroit où il prend position.",
   "accent_words": [
    "prend position"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n7",
   "text": "En 2024, presque un électeur sur deux doutait de son vote.",
   "accent_words": [
    "doutait"
   ],
   "claim_type": "fait_public"
  },
  {
   "id": "n8",
   "text": "Envoie ça au pote qui hésite entre gauche et centre.",
